# Miniflux MCP Server Configuration

# Miniflux server URL (required)
MINIFLUX_URL=https://your-miniflux-instance.com

# Credential source: config (one configured identity) or header
# (per-request X-Miniflux-Token; requires streamable-http)
# MINIFLUX_CREDENTIAL_SOURCE=config

# Authentication: Use either API key OR username/password (config mode only)
# Option 1: API Key authentication (recommended)
MINIFLUX_API_KEY=your_api_key_here

# Option 2: Username/password authentication
# MINIFLUX_USERNAME=your_username
# MINIFLUX_PASSWORD=your_password

# Optional proxy used only for this process's requests to Miniflux.
# Supports http, https, socks5, and socks5h; NO_PROXY remains effective.
# MINIFLUX_PROXY_URL=http://proxy.example:8080

# MCP transport: stdio (default) or streamable-http
# MCP_TRANSPORT=streamable-http
# MCP_HTTP_ADDR=:8080
# MCP_HTTP_PATH=/mcp

# Required when MCP_TRANSPORT=streamable-http.
# This token protects the remote MCP endpoint and is separate from Miniflux authentication.
# MCP_AUTH_TOKEN=replace_with_a_strong_secret

# Comma-separated write-tool allowlist (empty; read-only by default)
# MCP_WRITE_TOOLS=update_entry_status,toggle_starred

# Presentation of untrusted article content: markdown (default) or html
# MCP_CONTENT_FORMAT=markdown

# Comma-separated browser origins allowed for streamable-http
# MCP_ALLOWED_ORIGINS=https://mcp-ui.example.com
